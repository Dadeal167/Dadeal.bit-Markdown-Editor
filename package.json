    "diff": "9.0.0",
    "docx": "9.15.4",
    "dompurify": "3.4.18",
    "fflate": "0.8.3",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "markdown-it": "14.3.2",
    "mermaid": "12.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tiptap-markdown": "^0.9.0",
    "webwallgl": "3.0.2"
