  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "14.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
